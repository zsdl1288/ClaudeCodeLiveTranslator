#include <winver.h>
#include "../include/resource.h"
IDI_APP_ICON ICON "../assets/app.ico"

1 VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Claude Desktop Live Translator"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "ClaudeTranslator"
            VALUE "OriginalFilename", "ClaudeTranslator.exe"
            VALUE "ProductName", "Claude Desktop Live Translator"
            VALUE "ProductVersion", "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
