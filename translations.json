{
  "description": "Claude Code CLI 中英文翻译映射表 (基于实际输出捕获)",
  "version": "2.0.0",
  "regex_patterns": [
    [
      "\\b(\\d+)\\s*tokens? used\\b",
      "已用 \\1 Token"
    ],
    [
      "\\b(\\d+)\\s*tokens? remaining\\b",
      "剩余 \\1 Token"
    ],
    [
      "\\bCost:\\s*\\$?(\\d+\\.?\\d*)\\b",
      "费用: $\\1"
    ],
    [
      "\\bDuration:\\s*(.+?)\\b",
      "耗时: \\1"
    ],
    [
      "\\bLines added:\\s*(\\d+)\\b",
      "添加行数: \\1"
    ],
    [
      "\\bLines removed:\\s*(\\d+)\\b",
      "删除行数: \\1"
    ],
    [
      "\\bModel:\\s*(\\w[\\w.-]*)\\b",
      "模型: \\1"
    ]
  ],
